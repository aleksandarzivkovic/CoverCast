# Copy this file to secrets.yaml and fill in real values.
# secrets.yaml is gitignored and must never be committed.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Generate with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "GENERATE_A_BASE64_KEY"

ota_password: "GENERATE_A_RANDOM_PASSWORD"
